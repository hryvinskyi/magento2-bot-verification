<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Cron:etc/crontab.xsd">
    <group id="default">
        <!-- Four times a day, so a list whose fetch fails is retried many times before its snapshot grows too old to
             accuse anyone. -->
        <job name="hryvinskyi_bot_verification_refresh"
             instance="Hryvinskyi\BotVerification\Cron\RefreshRangeLists"
             method="execute">
            <schedule>17 */6 * * *</schedule>
        </job>
    </group>
</config>
